# Same Supabase project as apps/web (anon key only, never the service-role key).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# apps/api. On a physical phone use your computer's LAN address, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8001
